SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=18080

# Default local DB is in-memory H2. To keep data across restarts, uncomment the
# file-based URL and change GOVERNANCE_SQL_INIT_MODE to never after the first
# schema creation startup.
# GOVERNANCE_LOCAL_DATASOURCE_URL=jdbc:h2:file:./.local-db/governance;MODE=Oracle;AUTO_SERVER=TRUE
GOVERNANCE_LOCAL_DATASOURCE_DRIVER=org.h2.Driver
GOVERNANCE_LOCAL_DATASOURCE_USERNAME=sa
GOVERNANCE_LOCAL_DATASOURCE_PASSWORD=

GOVERNANCE_SQL_INIT_MODE=embedded
GOVERNANCE_BATCH_SCHEMA_INITIALIZE=embedded
GOVERNANCE_H2_CONSOLE_ENABLED=true
GOVERNANCE_CACHE_TYPE=simple
GOVERNANCE_REDIS_HEALTH_ENABLED=false

GOVERNANCE_MULTIPART_MAX_FILE_SIZE=20MB
GOVERNANCE_MULTIPART_MAX_REQUEST_SIZE=25MB
# GOVERNANCE_ATTACHMENT_STORAGE_ROOT=C:/workspace/governance-portal/.local-data/attachments

GOVERNANCE_FRONTEND_DEV_SERVER_ENABLED=true
GOVERNANCE_FRONTEND_DEV_SERVER_RESTART=true
GOVERNANCE_FRONTEND_DEV_SERVER_BUILD_BEFORE_START=true
