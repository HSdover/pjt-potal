SPRING_PROFILES_ACTIVE=saml,prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080
GOVERNANCE_MULTIPART_MAX_FILE_SIZE=20MB
GOVERNANCE_MULTIPART_MAX_REQUEST_SIZE=25MB
GOVERNANCE_ATTACHMENT_STORAGE_ROOT=/opt/governance-portal/attachments

# Production profile disables schema.sql/data.sql. Application tables and
# Spring Batch BATCH_* metadata tables must be prepared before startup.
GOVERNANCE_BATCH_SCHEMA_INITIALIZE=never
GOVERNANCE_SQL_INIT_MODE=never

GOVERNANCE_PROD_DATASOURCE_URL=jdbc:oracle:thin:@//prod-db-host:1521/service
GOVERNANCE_PROD_DATASOURCE_DRIVER=oracle.jdbc.OracleDriver
GOVERNANCE_PROD_DATASOURCE_USERNAME=appuser
GOVERNANCE_PROD_DATASOURCE_PASSWORD=change-me
GOVERNANCE_DATASOURCE_MAX_POOL_SIZE=20
GOVERNANCE_DATASOURCE_MIN_IDLE=5
GOVERNANCE_DATASOURCE_CONNECTION_TIMEOUT=30000

# Wallet example:
# GOVERNANCE_PROD_DATASOURCE_URL=jdbc:oracle:thin:@prod_db_high?TNS_ADMIN=/opt/governance-portal/config/wallet

# Redis cache
GOVERNANCE_CACHE_TYPE=redis
GOVERNANCE_CACHE_REDIS_TTL=300s
GOVERNANCE_CACHE_REDIS_KEY_PREFIX=governance:
GOVERNANCE_REDIS_HOST=redis-host
GOVERNANCE_REDIS_PORT=6379
GOVERNANCE_REDIS_DATABASE=0
GOVERNANCE_REDIS_PASSWORD=
GOVERNANCE_REDIS_TIMEOUT=2s
GOVERNANCE_REDIS_HEALTH_ENABLED=true

GOVERNANCE_EXTERNAL_API_CONNECT_TIMEOUT=3s
GOVERNANCE_EXTERNAL_API_READ_TIMEOUT=10s
GOVERNANCE_EXTERNAL_API_LOGGING_ENABLED=true

SAML_IDP_METADATA_URI=https://idp.example.com/metadata
SAML_SP_ENTITY_ID=https://portal.example.com/saml2/service-provider-metadata/knox
SAML_SP_ACS_LOCATION=https://portal.example.com/login/saml2/sso/knox

# Use local metadata when outbound access to the IdP metadata URL is blocked.
# SAML_IDP_METADATA_URI=file:/opt/governance-portal/config/idp-metadata.xml
