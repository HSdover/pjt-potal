SPRING_PROFILES_ACTIVE=saml,dev
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080
GOVERNANCE_MULTIPART_MAX_FILE_SIZE=20MB
GOVERNANCE_MULTIPART_MAX_REQUEST_SIZE=25MB
GOVERNANCE_ATTACHMENT_STORAGE_ROOT=/opt/governance-portal/attachments-dev

# Development DB profile. schema.sql/data.sql are not executed against a real
# development DB because they drop and recreate local sample tables.
GOVERNANCE_BATCH_SCHEMA_INITIALIZE=never
GOVERNANCE_SQL_INIT_MODE=never

GOVERNANCE_DEV_DATASOURCE_URL=jdbc:oracle:thin:@//dev-db-host:1521/service
GOVERNANCE_DEV_DATASOURCE_DRIVER=oracle.jdbc.OracleDriver
GOVERNANCE_DEV_DATASOURCE_USERNAME=dev_appuser
GOVERNANCE_DEV_DATASOURCE_PASSWORD=change-me
GOVERNANCE_DATASOURCE_MAX_POOL_SIZE=10
GOVERNANCE_DATASOURCE_MIN_IDLE=2
GOVERNANCE_DATASOURCE_CONNECTION_TIMEOUT=30000

# Wallet example:
# GOVERNANCE_DEV_DATASOURCE_URL=jdbc:oracle:thin:@dev_db_high?TNS_ADMIN=/opt/governance-portal/config/wallet-dev

# Keep development server runnable without Redis by default. Set redis values
# and GOVERNANCE_CACHE_TYPE=redis when a shared dev Redis is available.
GOVERNANCE_CACHE_TYPE=simple
GOVERNANCE_REDIS_HEALTH_ENABLED=false
GOVERNANCE_REDIS_HOST=redis-dev-host
GOVERNANCE_REDIS_PORT=6379
GOVERNANCE_REDIS_DATABASE=0
GOVERNANCE_REDIS_PASSWORD=
GOVERNANCE_REDIS_TIMEOUT=2s

GOVERNANCE_EXTERNAL_API_CONNECT_TIMEOUT=3s
GOVERNANCE_EXTERNAL_API_READ_TIMEOUT=10s
GOVERNANCE_EXTERNAL_API_LOGGING_ENABLED=true

SAML_IDP_METADATA_URI=https://dev-idp.example.com/metadata
SAML_SP_ENTITY_ID=https://dev-portal.example.com/saml2/service-provider-metadata/knox
SAML_SP_ACS_LOCATION=https://dev-portal.example.com/login/saml2/sso/knox

# Use local metadata when outbound access to the IdP metadata URL is blocked.
# SAML_IDP_METADATA_URI=file:/opt/governance-portal/config/idp-metadata-dev.xml
